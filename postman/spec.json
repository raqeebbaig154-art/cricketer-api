{
  "name": "Cricketer Management API - CRUD Tests",
  "description": "Postman tests for the Cricketer Management REST API (Express + SQLite).",
  "baseUrl": "http://localhost:3000",
  "steps": [
    { "id": "TC01", "name": "Create a valid cricketer", "method": "POST", "path": "/api/cricketers", "status": 201, "saveId": true,
      "body": { "name": "Babar Azam", "jerseyNo": 56, "team": "Pakistan", "role": "Batsman", "matches": 120, "runs": 5000 },
      "tests": [ { "name": "response contains generated id and same data", "code": "pm.expect(body.id).to.be.a('number'); pm.expect(body.name).to.eql('Babar Azam'); pm.expect(body.jerseyNo).to.eql(56);" } ] },
    { "id": "TC02", "name": "Retrieve all cricketers", "method": "GET", "path": "/api/cricketers", "status": 200,
      "tests": [ { "name": "returns an array containing the created record", "code": "pm.expect(body).to.be.an('array'); pm.expect(body.map(x => x.id)).to.include(Number(pm.collectionVariables.get('id')));" } ] },
    { "id": "TC03", "name": "Retrieve a single cricketer by id", "method": "GET", "path": "/api/cricketers/{{id}}", "status": 200,
      "tests": [ { "name": "returns the requested record", "code": "pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('id'))); pm.expect(body.team).to.eql('Pakistan');" } ] },
    { "id": "TC04", "name": "Update an existing cricketer", "method": "PUT", "path": "/api/cricketers/{{id}}", "status": 200,
      "body": { "name": "Babar Azam", "jerseyNo": 56, "team": "Pakistan", "role": "Batsman", "matches": 125, "runs": 5400 },
      "tests": [ { "name": "returned data shows the updated values", "code": "pm.expect(body.matches).to.eql(125); pm.expect(body.runs).to.eql(5400);" } ] },
    { "id": "TC05", "name": "Confirm update persisted in database", "method": "GET", "path": "/api/cricketers/{{id}}", "status": 200,
      "tests": [ { "name": "database holds updated values", "code": "pm.expect(body.matches).to.eql(125); pm.expect(body.runs).to.eql(5400);" } ] },
    { "id": "TC06", "name": "Create with required fields missing", "method": "POST", "path": "/api/cricketers", "status": 400,
      "body": { "jerseyNo": 10 },
      "tests": [ { "name": "error lists name, team and role problems", "code": "pm.expect(body.error).to.eql('Validation failed'); pm.expect(body.details.length).to.be.at.least(3);" } ] },
    { "id": "TC07", "name": "Create with invalid role and negative runs", "method": "POST", "path": "/api/cricketers", "status": 400,
      "body": { "name": "Test Player", "jerseyNo": 11, "team": "Pakistan", "role": "Umpire", "runs": -5 },
      "tests": [ { "name": "error mentions role and runs", "code": "const t = body.details.join(' '); pm.expect(t).to.include('role'); pm.expect(t).to.include('runs');" } ] },
    { "id": "TC08", "name": "Create with duplicate jersey number", "method": "POST", "path": "/api/cricketers", "status": 409,
      "body": { "name": "Another Player", "jerseyNo": 56, "team": "Pakistan", "role": "Bowler" },
      "tests": [ { "name": "conflict error returned", "code": "pm.expect(body.error).to.eql('Conflict');" } ] },
    { "id": "TC09", "name": "Create with malformed JSON body", "method": "POST", "path": "/api/cricketers", "status": 400,
      "raw": "{ \"name\": \"Broken\", ",
      "tests": [ { "name": "malformed JSON error returned", "code": "pm.expect(body.error).to.eql('Malformed JSON');" } ] },
    { "id": "TC10", "name": "Get a nonexistent id", "method": "GET", "path": "/api/cricketers/9999", "status": 404,
      "tests": [ { "name": "Not Found error returned", "code": "pm.expect(body.error).to.eql('Not Found');" } ] },
    { "id": "TC11", "name": "Update a nonexistent id", "method": "PUT", "path": "/api/cricketers/9999", "status": 404,
      "body": { "name": "Ghost", "jerseyNo": 99, "team": "None", "role": "Bowler" },
      "tests": [ { "name": "Not Found error returned", "code": "pm.expect(body.error).to.eql('Not Found');" } ] },
    { "id": "TC12", "name": "Get with a non-numeric id", "method": "GET", "path": "/api/cricketers/abc", "status": 400,
      "tests": [ { "name": "Invalid id error returned", "code": "pm.expect(body.error).to.eql('Invalid id');" } ] },
    { "id": "TC13", "name": "Delete an existing cricketer", "method": "DELETE", "path": "/api/cricketers/{{id}}", "status": 200,
      "tests": [ { "name": "confirmation message returned", "code": "pm.expect(body.message).to.include('deleted');" } ] },
    { "id": "TC14", "name": "Confirm deleted record cannot be retrieved", "method": "GET", "path": "/api/cricketers/{{id}}", "status": 404,
      "tests": [ { "name": "Not Found error returned", "code": "pm.expect(body.error).to.eql('Not Found');" } ] },
    { "id": "TC15", "name": "Delete the already-deleted record", "method": "DELETE", "path": "/api/cricketers/{{id}}", "status": 404,
      "tests": [ { "name": "Not Found error returned", "code": "pm.expect(body.error).to.eql('Not Found');" } ] }
  ]
}
